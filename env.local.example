# Copy to `.env.local` and fill in values.

# Supabase (required for auth and data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# After connecting Supabase, run SQL scripts in the Supabase SQL Editor:
# - scripts/supabase-profiles.sql (required for onboarding)
# - scripts/supabase-categories-rls.sql, supabase-expenses-rls.sql, etc. as needed

# OpenAI (optional — AI insights show a friendly message when missing)
OPENAI_API_KEY=sk-your-key-here

# Cheap default model; override if needed
OPENAI_MODEL=gpt-4o-mini
